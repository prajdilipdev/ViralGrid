# MongoDB connection string (required).
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name (optional, defaults to "viralgrid")
DB_NAME=viralgrid

# Comma-separated list of allowed frontend origins for CORS (required in production).
# Example: https://viralgrid-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000

# --- Real Instagram publishing (optional) ---
# From your Meta app: App Dashboard > Instagram > API setup with Instagram login.
# Leave unset to keep Instagram simulated like the other platforms.
# IG_APP_ID=
# IG_APP_SECRET=

# From Google Cloud: enable "YouTube Data API v3", then create an OAuth client
# ID of type "Web application" whose authorised redirect URI is
#   <PUBLIC_BACKEND_URL>/api/youtube/callback
# Leave unset to keep YouTube simulated.
# Note: until Google audits the project, YouTube force-locks every uploaded
# video to Private regardless of what is requested here.
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# Privacy requested for new uploads: public | unlisted | private
# YT_PRIVACY_STATUS=public
# YouTube category id — 22 is People & Blogs, 20 is Gaming.
# YT_CATEGORY_ID=22

# Public https URL of THIS backend. Required for Instagram (it fetches your
# video from a public URL) and for the OAuth redirect.
# PUBLIC_BACKEND_URL=https://viralgrid-backend.onrender.com

# Uploads live on an ephemeral disk that is wiped on every restart/redeploy, so
# a copy of each file is also kept in MongoDB and restored on demand. Files
# larger than this are skipped to protect a small Atlas quota (free tier = 512MB
# total). Raise it if your database has room.
# MEDIA_DB_MAX_MB=60

# Optional but recommended for a private instance: comma-separated list of Google
# account emails allowed to sign in. Leave unset to allow any Google account.
# ALLOWED_EMAILS=you@gmail.com

# Optional: Emergent universal LLM key. Enables the AI copy generation endpoint
# and Emergent object storage backup of uploaded media. Leave unset to disable both.
# EMERGENT_LLM_KEY=sk-emergent-...

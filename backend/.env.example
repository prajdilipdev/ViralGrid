# MongoDB connection string (required).
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name (optional, defaults to "viralgrid")
DB_NAME=viralgrid

# Comma-separated list of allowed frontend origins for CORS (required in production).
# Example: https://viralgrid-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000

# Optional but recommended for a private instance: comma-separated list of Google
# account emails allowed to sign in. Leave unset to allow any Google account.
# ALLOWED_EMAILS=you@gmail.com

# Optional: Emergent universal LLM key. Enables the AI copy generation endpoint
# and Emergent object storage backup of uploaded media. Leave unset to disable both.
# EMERGENT_LLM_KEY=sk-emergent-...
